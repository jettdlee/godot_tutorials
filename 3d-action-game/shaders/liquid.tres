code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;


// Varyings
varying vec3 var_wave_texture;

uniform float WaveHeight;
uniform float Speed;
uniform vec2 Direction;
uniform sampler2D WaveTexture;
uniform float Contrast : hint_range(1.0, 4.0) = 1.0;
uniform vec4 ColorA : source_color;
uniform vec4 ColorB : source_color;
uniform float Alpha : hint_range(0.0, 1.0) = 0.80000001192093;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// FloatParameter:6
	float n_out6p0 = WaveHeight;


// Input:12
	float n_out12p0 = TIME;


// FloatParameter:13
	float n_out13p0 = Speed;


// FloatOp:17
	float n_out17p0 = n_out12p0 * n_out13p0;


// Vector2Parameter:15
	vec2 n_out15p0 = Direction;


// VectorOp:14
	vec2 n_out14p0 = vec2(n_out17p0) * n_out15p0;


// UVFunc:11
	vec2 n_in11p1 = vec2(1.00000, 1.00000);
	vec2 n_out11p0 = n_out14p0 * n_in11p1 + UV;


	vec4 n_out5p0;
// Texture2D:5
	n_out5p0 = texture(WaveTexture, n_out11p0);


// FloatParameter:10
	float n_out10p0 = Contrast;


// VectorOp:9
	vec3 n_out9p0 = pow(vec3(n_out5p0.xyz), vec3(n_out10p0));
	float n_out9p2 = n_out9p0.g;


// FloatOp:7
	float n_out7p0 = n_out6p0 * n_out9p2;


// VectorOp:3
	vec3 n_out3p0 = n_out2p0 + vec3(n_out7p0);


// Output:0
	VERTEX = n_out3p0;


// VaryingSetter:8
	var_wave_texture = n_out9p0;


}

void fragment() {
// ColorParameter:3
	vec4 n_out3p0 = ColorA;


// VaryingGetter:2
	vec3 n_out2p0 = var_wave_texture;


// VectorOp:5
	vec3 n_out5p0 = vec3(n_out3p0.xyz) * n_out2p0;


// VectorFunc:6
	vec3 n_out6p0 = vec3(1.0) - n_out2p0;


// ColorParameter:4
	vec4 n_out4p0 = ColorB;


// VectorOp:7
	vec3 n_out7p0 = n_out6p0 * vec3(n_out4p0.xyz);


// VectorOp:8
	vec3 n_out8p0 = n_out5p0 + n_out7p0;


// FloatParameter:9
	float n_out9p0 = Alpha;


// Output:0
	ALBEDO = n_out8p0;
	ALPHA = n_out9p0;


}
